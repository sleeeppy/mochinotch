<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mochinotch.Win</RootNamespace>
    <AssemblyName>Mochinotch</AssemblyName>
    <Version>0.6.16</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\Assets\MochinotchIcon.png" Link="MochinotchIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Mochinotch\ToolIcons\*.png" Link="ToolIcons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mochinotch.Win.Core\Mochinotch.Win.Core.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
  </ItemGroup>
</Project>
