{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "~/.local/bin/mochinotch-notify --source cursor"
      }
    ],
    "preToolUse": [
      {
        "command": "~/.local/bin/mochinotch-notify --source cursor",
        "matcher": "AskQuestion|AskUserQuestion"
      }
    ]
  }
}
